{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "superAutoResearch Registry Entry",
  "type": "object",
  "required": ["repo", "kind", "owners"],
  "additionalProperties": false,
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 3,
      "pattern": "^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+|file://.+)$"
    },
    "kind": {
      "type": "string",
      "enum": ["native", "external"]
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9-]+$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "listed": {
      "type": "boolean"
    },
    "added": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "statement_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{16,64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "local_path": {
      "type": "string",
      "minLength": 1
    },
    "discussion_url": {
      "type": "string"
    },
    "attempts_override": {
      "type": "integer",
      "minimum": 0
    },
    "contributors_override": {
      "type": "integer",
      "minimum": 0
    },
    "spec": {
      "type": "object",
      "required": ["title", "summary", "metric", "verifier", "baseline", "records_source"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "submit": { "type": "string" },
        "rules_url": { "type": "string" },
        "metric": {
          "type": "object",
          "required": ["name", "direction"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "unit": { "type": "string" },
            "direction": { "type": "string", "enum": ["min", "max"] },
            "scale": { "type": "string", "enum": ["linear", "log"] },
            "display": { "type": "string" }
          }
        },
        "verifier": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["script", "lean", "manual", "custom"] }
          }
        },
        "baseline": {
          "type": "object",
          "required": ["value", "label"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "number" },
            "label": { "type": "string", "minLength": 1 },
            "source": { "type": "string" }
          }
        },
        "records_source": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["leaderboard-json", "readme-table", "hub"] },
            "url": { "type": "string" },
            "table_heading": { "type": "string" },
            "columns": {
              "type": "object",
              "properties": {
                "value": { "type": "string" },
                "date": { "type": "string" },
                "author": { "type": "string" },
                "link": { "type": "string" }
              }
            }
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "title": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": { "kind": { "const": "external" } },
    "required": ["kind"]
  },
  "then": {
    "required": ["spec"]
  }
}
